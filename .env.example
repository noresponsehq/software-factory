# Local credentials are loaded only from /Users/harryjohnston/projects/noresponse/.env.
# This file documents names; do not copy it into a second credentials file.
# `npm run setup:render` copies these values into the Render env groups render.yaml links; see
# docs/configuration.md#environment-groups.

# Both services: Render API key (the gateway starts tasks; workflows manage sandboxes and cancel runs).
RENDER_API_KEY=

# Gateway.
PORT=3000
# Secret configured on the GitHub App's webhook.
GITHUB_WEBHOOK_SECRET=
# Slug of the factory-workflows service; tasks start as <slug>/<task>.
RENDER_WORKFLOW_SLUG=factory-workflows

# Workflows.
RENDER_WORKSPACE_ID=
# GitHub App credentials; the installation comes from each webhook.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Claude subscription token, never an API key.
CLAUDE_CODE_OAUTH_TOKEN=
NR_LEDGER_URL=https://accounts-mcp.harry-ed3.workers.dev
NR_FACTORY_OPERATOR_TOKEN=
LINEAR_API_KEY=
FLY_API_TOKEN=
NR_PROD_SEARCH_API_KEY=
# Optional: GitHub API base URL, for GitHub Enterprise Server.
GITHUB_API_URL=
